# Application Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-strong-random-production-secret-key

# Database Configuration (Local MySQL or Cloud MySQL e.g. Aiven/TiDB/Railway/PlanetScale)
# In production, set DATABASE_URL (e.g. mysql+pymysql://user:pass@host:port/dbname?charset=utf8mb4)
# OR set DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME directly.
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_civic_complaints
# DATABASE_URL=mysql+pymysql://user:password@mysql-host:3306/smart_civic_complaints?charset=utf8mb4
# DB_SSL=true

# CORS & Frontend Integration
# Allowed origins for credentialed API requests (comma-separated)
CORS_ORIGINS=https://sccmt.vercel.app
# Optional explicit API base URL (leave empty when Vercel proxies directly to Render)
API_BASE_URL=

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Session & Cookie Security (Use Secure=true in HTTPS production)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

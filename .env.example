# Application Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=civic-complaint-secret-key-production-replace-in-real-prod-2026

# MySQL Database Configuration
# Default XAMPP setup: user 'root' with empty password on port 3306
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_civic_complaints
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10MB limit

# Session Configuration
PERMANENT_SESSION_LIFETIME=86400 # 24 hours in seconds
